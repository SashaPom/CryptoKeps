-        int zeroes = 0;
-        String s = String.format("%.12f", decimal).replaceAll("[,.]", "");
-        for (char c : s.toCharArray()) {
-            if (c == '0') {
-                zeroes++;
-            } else if (c != '-') {
-                break;
-            }
-        }
-        NumberFormat decimalFormat = new DecimalFormat("0." + "0".repeat(3 + zeroes));
